# ============================================================
# Chạy local tối thiểu: 5 dòng dưới là đủ cho dev.
# ============================================================
# Chuỗi kết nối MongoDB local (khớp giá trị mặc định trong application.yml)
MONGODB_URI=mongodb://localhost:27017/mocan_shop
# Chuỗi bí mật ký JWT — BẮT BUỘC tự đặt một chuỗi ngẫu nhiên DÀI (tối thiểu 32 ký tự)
# rồi bỏ dấu # ở đầu dòng. Để nguyên dòng comment thì app dùng giá trị mặc định
# trong application.yml; TUYỆT ĐỐI không để dòng JWT_SECRET= trống (app sẽ crash
# lúc khởi động vì Keys.hmacShaKeyFor không chấp nhận secret rỗng).
# JWT_SECRET=<dien-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu>
# Tài khoản ADMIN thật do AdminBootstrap tạo lúc backend khởi động lần đầu.
# Bắt buộc cả 3, SĐT đúng định dạng VN, mật khẩu >= 8 ký tự — thiếu thì chỉ
# log WARN rồi bỏ qua (app vẫn chạy, nhưng /admin/** không đăng nhập được).
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=
# MoMo — F-008. Copy thành .env (hoặc export biến môi trường) rồi điền giá trị thật.
# TUYỆT ĐỐI không commit file chứa secret thật lên git.
# Lấy bộ test sandbox tại https://developers.momo.vn (đăng ký merchant test).

# Mã đối tác MoMo cấp
MOMO_PARTNER_CODE=
# Access key đi kèm partnerCode
MOMO_ACCESS_KEY=
# Secret key — CHỈ backend dùng để ký/verify, không bao giờ ra frontend/log
MOMO_SECRET_KEY=
# Mặc định sandbox; production: https://payment.momo.vn/v2/gateway/api/create
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
# URL public của backend để MoMo gọi IPN, vd: https://api.mocan.vn/payments/momo/ipn
MOMO_IPN_URL=
# URL FE trang kết quả MoMo redirect về sau khi user xác nhận, vd: https://mocan.vn/dat-hang/thanh-cong
MOMO_REDIRECT_URL=

# ============================================================
# Lưu trữ ảnh (StorageService) — áp cho ảnh của SHOP (sản phẩm/danh mục/banner)
# và ảnh gốc của USER (review). Ảnh review trên production được Lambda nén
# (xem infra/lambda-image-compressor/README.md), app chỉ giữ URL bản tối ưu.
# ============================================================
# local = ghi xuống ổ đĩa server (APP_UPLOAD_DIR, mặc định ./uploads) — chỉ để dev.
# s3    = cloud object storage tương thích S3 — dùng khi vận hành thật.
STORAGE_TYPE=local
# Thư mục ghi ảnh khi STORAGE_TYPE=local
APP_UPLOAD_DIR=uploads
# Endpoint S3: ĐỂ TRỐNG nếu dùng AWS S3 xịn.
#   Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
#   MinIO tự host:  http://localhost:9000 (hoặc domain máy MinIO của bạn)
S3_ENDPOINT=
# Region: AWS vd ap-southeast-1 · Cloudflare R2 dùng "auto" · MinIO dùng us-east-1
S3_REGION=
# Tên bucket chứa ảnh (tạo trước trên nhà cung cấp)
S3_BUCKET=
# Khóa truy cập — CHỈ backend dùng, không bao giờ ra frontend/log
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Domain public/CDN trỏ vào bucket, vd https://cdn.mocan.vn — có thì URL ảnh dùng domain này,
# không có thì backend tự dựng URL theo endpoint/bucket/region.
S3_PUBLIC_BASE_URL=
# true = URL dạng endpoint/bucket/key (MinIO bắt buộc; R2 bật khi cần)
S3_PATH_STYLE=false
